$ErrorActionPreference = "Stop"

$testFiles = @(
    [PSCustomObject]@{
        File = "Test-AccessProfile.ps1"
        Marker = "All access-profile tests passed."
    },
    [PSCustomObject]@{
        File = "Test-Lifecycle.ps1"
        Marker = "All lifecycle tests passed."
    },
    [PSCustomObject]@{
        File = "Test-ApprovalGate.ps1"
        Marker = "All approval-gate tests passed."
    }
)

$results = @()

foreach ($test in $testFiles) {
    $path = Join-Path $PSScriptRoot $test.File
    Write-Host "`nRunning $($test.File)" -ForegroundColor Cyan

    if (-not (Test-Path -LiteralPath $path)) {
        $results += [PSCustomObject]@{ Test = $test.File; Status = "FAIL"; Detail = "File not found" }
        Write-Host "FAIL: File not found." -ForegroundColor Red
        continue
    }

    try {
        $output = & {
            $ErrorActionPreference = "Stop"
            . $path
        } 2>&1

        foreach ($line in $output) {
            Write-Host $line
        }

        $textOutput = ($output | ForEach-Object { [string]$_ }) -join "`n"
        if (-not $textOutput.Contains($test.Marker)) {
            throw "Required pass marker not found: $($test.Marker)"
        }

        $results += [PSCustomObject]@{ Test = $test.File; Status = "PASS"; Detail = "Pass marker verified" }
        Write-Host "RESULT: PASS" -ForegroundColor Green
    }
    catch {
        $results += [PSCustomObject]@{ Test = $test.File; Status = "FAIL"; Detail = $_.Exception.Message }
        Write-Host "RESULT: FAIL - $($_.Exception.Message)" -ForegroundColor Red
    }
}

Write-Host "`nTEST SUMMARY" -ForegroundColor Cyan
$results | Format-Table Test, Status, Detail -AutoSize

$passed = @($results | Where-Object { $_.Status -eq "PASS" }).Count
$failed = @($results | Where-Object { $_.Status -eq "FAIL" }).Count

Write-Host "Passed: $passed"
Write-Host "Failed: $failed"

if ($failed -gt 0) {
    throw "One or more test scripts failed."
}

Write-Host "All required test markers verified." -ForegroundColor Green
