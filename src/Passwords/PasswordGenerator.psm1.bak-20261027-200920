function Get-IdentityOpsSecureIndex {
    param(
        [Parameter(Mandatory)]
        [ValidateRange(1, 2147483647)]
        [int]$Maximum
    )

    # Cryptographic random bytes; compatible with .NET Framework.
    # Rejection sampling avoids modulo bias.
    $rng = New-Object System.Security.Cryptography.RNGCryptoServiceProvider

    try {
        [byte[]]$bytes = New-Object byte[] 4
        [uint64]$range = 4294967296
        [uint64]$limit = [math]::Floor($range / $Maximum) * $Maximum

        do {
            $rng.GetBytes($bytes)
            [uint64]$value = [System.BitConverter]::ToUInt32($bytes, 0)
        } while ($value -ge $limit)

        return [int]($value % $Maximum)
    }
    finally {
        $rng.Dispose()
    }
}

function Get-IdentityOpsSecureCharacter {
    param(
        [Parameter(Mandatory)]
        [string]$Characters
    )

    $index = Get-IdentityOpsSecureIndex -Maximum $Characters.Length
    return [string]$Characters[$index]
}

function New-IdentityOpsPassword {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [ValidateSet("Strong", "Account", "Temporary")]
        [string]$Mode,

        [ValidateRange(8, 128)]
        [int]$Length = 12,

        [string[]]$WordList = @(
            "amber", "birch", "cobalt", "delta", "ember",
            "frost", "ghost", "harbor", "ivory", "jungle",
            "lantern", "maple", "nectar", "orbit", "pixel",
            "quartz", "raven", "silver", "timber", "velvet"
        )
    )

    $upper = "ABCDEFGHJKLMNPQRSTUVWXYZ"
    $lower = "abcdefghijkmnopqrstuvwxyz"
    $digits = "23456789"
    $special = '!@#$%*-_+='
    $all = $upper + $lower + $digits + $special

    switch ($Mode) {
        "Strong" {
            $chars = [System.Collections.Generic.List[char]]::new()

            foreach ($set in @($upper, $lower, $digits, $special)) {
                $chars.Add((Get-IdentityOpsSecureCharacter $set)[0])
            }

            while ($chars.Count -lt 20) {
                $chars.Add((Get-IdentityOpsSecureCharacter $all)[0])
            }

            for ($i = $chars.Count - 1; $i -gt 0; $i--) {
                $j = Get-IdentityOpsSecureIndex ($i + 1)
                $temp = $chars[$i]
                $chars[$i] = $chars[$j]
                $chars[$j] = $temp
            }

            return -join $chars.ToArray()
        }

        "Account" {
            if ($WordList.Count -lt 3) {
                throw "Account mode requires at least three words."
            }

            $selectedWords = @()

            for ($i = 0; $i -lt 3; $i++) {
                $wordIndex = Get-IdentityOpsSecureIndex $WordList.Count
                $selectedWords += [string]$WordList[$wordIndex]
            }

            foreach ($word in $selectedWords) {
                if ($word -notmatch '^[a-zA-Z]+$') {
                    throw "Account word list may contain only alphabetic words."
                }
            }

            $first = $selectedWords[0].Substring(0, 1).ToUpperInvariant() +
                $selectedWords[0].Substring(1)

            $second = $selectedWords[1]
            $third = $selectedWords[2]

            $digit = Get-IdentityOpsSecureCharacter $digits
            $symbol = Get-IdentityOpsSecureCharacter $special

            $secondIndex = Get-IdentityOpsSecureIndex ($second.Length + 1)
            $second = $second.Insert($secondIndex, $digit)

            $thirdIndex = Get-IdentityOpsSecureIndex ($third.Length + 1)
            $third = $third.Insert($thirdIndex, $symbol)

            return "$first $second $third"
        }

        "Temporary" {
            $chars = [System.Collections.Generic.List[char]]::new()

            $chars.Add((Get-IdentityOpsSecureCharacter $upper)[0])
            $chars.Add((Get-IdentityOpsSecureCharacter $lower)[0])
            $chars.Add((Get-IdentityOpsSecureCharacter $digits)[0])

            while ($chars.Count -lt $Length) {
                $chars.Add((Get-IdentityOpsSecureCharacter $all)[0])
            }

            for ($i = $chars.Count - 1; $i -gt 0; $i--) {
                $j = Get-IdentityOpsSecureIndex ($i + 1)
                $temp = $chars[$i]
                $chars[$i] = $chars[$j]
                $chars[$j] = $temp
            }

            return -join $chars.ToArray()
        }
    }
}

Export-ModuleMember -Function "New-IdentityOpsPassword"
